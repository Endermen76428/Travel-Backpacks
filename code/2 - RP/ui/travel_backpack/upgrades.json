{
  "namespace": "travel_backpack-upgrades",

  "hover_text_data_control": {
    "collection_index": "$index",
    "type": "panel",
    "size": [ 0, 0 ],
    "bindings": [
      {
        "binding_type": "collection",
        "binding_collection_name": "container_items",
        "binding_name": "#hover_text"
      },
      {
        "binding_type": "collection",
        "binding_collection_name": "container_items",
        "binding_name": "#item_id_aux"
      },
      {
        "binding_type": "view",
        "source_property_name": "(not (#item_id_aux = -1))", /* Testa-se-tem-um-item-no-slot,-será-utilizado-para-verificar-se-o-player-está-clicando,-pois-por-algum-motivo-o-hover-text-fica-vazio-se-clicar-em-outro-slot,-isso-que-segura-e-cria-compatibilidade-entre-plataformas */
        "target_property_name": "#has_item"
      },
      {
        "binding_type": "view",
        "source_property_name": "(((#hover_text = #preserved_text) or (#hover_text = '')))", /* Atualiza-a-visibilidade-do-painel-se-o-texto-preservado-for-igual-ao-texto-atual-ou-se-o-texto-atual-está-vazio */
        "target_property_name": "#visible"
      },
      {
        "binding_type": "collection",
        "binding_collection_name": "container_items",
        "binding_condition": "visibility_changed", /* Só-atualiza-o-preserved-text-se-a-visibilidade-desse-painel-for-alterada */
        "binding_name": "#hover_text",
        "binding_name_override": "#preserved_text"
      }
    ]
  },

  "upgrade_slots_panel@travel_backpack-common.backpack_background": {
    "size": [ 32, "100%c +10px" ],
    "controls": [
      {
        "slots_panel": {
          "$slot_visibility_1": "($inventory_size < 36)",
          "$slot_visibility_2": "($inventory_size < 54)",
          "$slot_visibility_3": "($inventory_size < 81)",
          "$slot_visibility_4": "($inventory_size < 100)",
          "$slot_visibility_5": "($inventory_size < 120)",
          "type": "stack_panel",
          "offset": [ 5, 0 ],
          "orientation": "vertical",
          "collection_name": "container_items",
          "controls": [
            { "slot_1@chest.chest_grid_item": { "collection_index": "($inventory_size)" } },
            { "padding@common.empty_panel": { "size": [ 0, 2], "ignored": "$slot_visibility_1" } },
            { "slot_2@chest.chest_grid_item": { "collection_index": "($inventory_size +1)", "ignored": "$slot_visibility_1" } },
            { "padding@common.empty_panel": { "size": [ 0, 2], "ignored": "$slot_visibility_2" } },
            { "slot_3@chest.chest_grid_item": { "collection_index": "($inventory_size +2)", "ignored": "$slot_visibility_2" } },
            { "padding@common.empty_panel": { "size": [ 0, 2], "ignored": "$slot_visibility_3" } },
            { "slot_4@chest.chest_grid_item": { "collection_index": "($inventory_size +3)", "ignored": "$slot_visibility_3" } },
            { "padding@common.empty_panel": { "size": [ 0, 2], "ignored": "$slot_visibility_4" } },
            { "slot_5@chest.chest_grid_item": { "collection_index": "($inventory_size +4)", "ignored": "$slot_visibility_4" } },
            { "padding@common.empty_panel": { "size": [ 0, 2], "ignored": "$slot_visibility_5" } },
            { "slot_6@chest.chest_grid_item": { "collection_index": "($inventory_size +5)", "ignored": "$slot_visibility_5" } }
          ]
        }
      }
    ]
  },

  "upgrade_functions_panel@travel_backpack-common.backpack_background": {
    "size": [ 25, "100%c +10px" ],
    "offset": [ 25, 0 ],
    "anchor_from": "top_right",
    "anchor_to": "top_right",
    "controls": [
      {
        "slots_panel": {
          "type": "stack_panel",
          "orientation": "vertical",
          "collection_name": "container_items",
          "controls": [
            {
              "upgrades_panel@common.empty_panel": {
                "controls": [
                  {
                    "upgrade_toggles": {
                      "type": "stack_panel",
                      "size": [ 21, 21 ],
                      "anchor_from": "top_middle",
                      "anchor_to": "top_middle",
                      "controls": [
                        { "craft_toggle@travel_backpack-upgrade_craft.upgrade_craft_panel": {} },
                        { "furnace_toggle@travel_backpack-upgrade_furnace.upgrade_furnace_panel": {} },
                        { "feed_toggle@travel_backpack-upgrade_feed.upgrade_feed_panel": {} }
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  }
}