{
  "namespace": "travel_backpack-upgrade_feed",

  "upgrade_feed_panel@common.root_panel": {
    "size": [ "100%cm", "100%cm" ],
    "controls": [
      {
        "craft_toggle@travel_backpack-common.upgrade_toggle_button": {
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "offset": [ -1.5, 0 ],
          "$index": 1,
          "$name": "$feed_toggle",
          "$off_texture|default": "textures/travel_backpack/ui/upgrades/feed/feed_off",
          "$off_hover_texture|default": "textures/travel_backpack/ui/upgrades/feed/feed_off_hover",
          "$on_texture|default": "textures/travel_backpack/ui/upgrades/feed/feed_off",
          "$on_hover_texture|default": "textures/travel_backpack/ui/upgrades/feed/feed_off_hover"
        }
      },
      {
        "feed_panel@travel_backpack-common.backpack_background": {
          "type": "image",
          "size": [ "100%c", "100%c" ],
          "offset": [ -0.5, 1 ],
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "controls": [
            { "default_size@common.empty_panel": { "size": [21, 21] } },
            {
              "feed_panel": {
                "type": "panel",
                "size": [ 54, 64 ],
                "controls": [
                  {
                    "feed_label": {
                      "type": "label",
                      "text": "container.feed",
                      "localize": true,
                      "offset": [ 10, -5 ],
                      "text_alignment": "left",
                      "anchor_from": "top_left",
                      "anchor_to": "top_left"
                    }
                  },
                  {
                    "grid_3x3": {
                      "type": "stack_panel",
                      "offset": [ 0, 7 ],
                      "controls": [
                        {
                          "layer_1": {
                            "type": "stack_panel",
                            "size": [ 54, 18 ],
                            "orientation": "horizontal",
                            "collection_name": "container_items",
                            "controls": [
                              { "slot_1@chest.chest_grid_item": { "collection_index": "($inventory_size +32)" } },
                              { "slot_2@chest.chest_grid_item": { "collection_index": "($inventory_size +33)" } },
                              { "slot_3@chest.chest_grid_item": { "collection_index": "($inventory_size +34)" } }
                            ]
                          }
                        },
                        {
                          "layer_2": {
                            "type": "stack_panel",
                            "size": [ 54, 18 ],
                            "orientation": "horizontal",
                            "collection_name": "container_items",
                            "controls": [
                              { "slot_4@chest.chest_grid_item": { "collection_index": "($inventory_size +35)" } },
                              { "slot_5@chest.chest_grid_item": { "collection_index": "($inventory_size +36)" } },
                              { "slot_6@chest.chest_grid_item": { "collection_index": "($inventory_size +37)" } }
                            ]
                          }
                        },
                        {
                          "layer_3": {
                            "type": "stack_panel",
                            "size": [ 54, 18 ],
                            "orientation": "horizontal",
                            "collection_name": "container_items",
                            "controls": [
                              { "slot_7@chest.chest_grid_item": { "collection_index": "($inventory_size +38)" } },
                              { "slot_8@chest.chest_grid_item": { "collection_index": "($inventory_size +39)" } },
                              { "slot_9@chest.chest_grid_item": { "collection_index": "($inventory_size +40)" } }
                            ]
                          }
                        }
                      ]
                    }
                  }
                ],
                "bindings": [
                  {
                    "binding_type": "view",
                    "source_control_name": "$feed_toggle",
                    "source_property_name": "#toggle_state",
                    "target_property_name": "#visible"
                  }
                ]
              }
            }
          ]
        }
      }
    ],
    "bindings": [
      { "binding_type": "view", "source_control_name": "hover_data_control_1", "source_property_name": "#preserved_text", "target_property_name": "#info_1" },
      { "binding_type": "view", "source_control_name": "hover_data_control_2", "source_property_name": "#preserved_text", "target_property_name": "#info_2" },
      { "binding_type": "view", "source_control_name": "hover_data_control_3", "source_property_name": "#preserved_text", "target_property_name": "#info_3" },
      { "binding_type": "view", "source_control_name": "hover_data_control_4", "source_property_name": "#preserved_text", "target_property_name": "#info_4" },
      { "binding_type": "view", "source_control_name": "hover_data_control_5", "source_property_name": "#preserved_text", "target_property_name": "#info_5" },
      { "binding_type": "view", "source_control_name": "hover_data_control_6", "source_property_name": "#preserved_text", "target_property_name": "#info_6" },

      { "binding_type": "view", "source_control_name": "hover_data_control_1", "source_property_name": "#has_item", "target_property_name": "#item_1" },
      { "binding_type": "view", "source_control_name": "hover_data_control_2", "source_property_name": "#has_item", "target_property_name": "#item_2" },
      { "binding_type": "view", "source_control_name": "hover_data_control_3", "source_property_name": "#has_item", "target_property_name": "#item_3" },
      { "binding_type": "view", "source_control_name": "hover_data_control_4", "source_property_name": "#has_item", "target_property_name": "#item_4" },
      { "binding_type": "view", "source_control_name": "hover_data_control_5", "source_property_name": "#has_item", "target_property_name": "#item_5" },
      { "binding_type": "view", "source_control_name": "hover_data_control_6", "source_property_name": "#has_item", "target_property_name": "#item_6" },

      {
        "binding_type": "view",
        "source_property_name": "( (('%.18s' * #info_1) = '§f§f§e§e§d§r' and #item_1) or (('%.18s' * #info_2) = '§f§f§e§e§d§r' and #item_2) or (('%.18s' * #info_3) = '§f§f§e§e§d§r' and #item_3) or (('%.18s' * #info_4) = '§f§f§e§e§d§r' and #item_4) or (('%.18s' * #info_5) = '§f§f§e§e§d§r' and #item_5) or (('%.18s' * #info_6) = '§f§f§e§e§d§r' and #item_6) )", /* Cada-combinação-de-§-considerá-como-3-e-possui-um-§f-no-inicio-de-todo-hover_text-por-algum-motivo,-sofri-pra-descobrir-isso-:( */
        "target_property_name": "#visible"
      }
    ]
  }
}