{
  "format_version": "1.10.0",
  "minecraft:attachable": {
    "description": {
      "identifier": "travel_backpack:copper_backpack",
      "materials": { "default": "entity_alphatest" },
      "textures": {
        "default": "textures/travel_backpack/blocks/backpack_base",
        "tier": "textures/travel_backpack/blocks/copper_tier"
      },
      "geometry": { "default": "geometry.travel_backpack.backpack" },
      "render_controllers": [
        "controller.render.travel_backpack.backpack",
        "controller.render.travel_backpack.backpack.tier"
      ],
      "animations": {
        "third_person": "animation.travel_backpack.attachables.backpack.third_person_hold"
      },
      "scripts": {
        "animate": [
          { "third_person": "!c.is_first_person && c.item_slot != 'main_hand'" }
        ]
      }
    }
  }
}