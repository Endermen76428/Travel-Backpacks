{
  "format_version": "1.26.20",
  "minecraft:entity": {
    "description": {
      "identifier": "travel_backpack:backpack",
      "is_summonable": true,
      "is_spawnable": false,
      "is_experimental": false,
      "properties": {
        "travel_backpack:on_ground": { "type": "bool", "default": false },
        "travel_backpack:level": { "type": "int", "range": [-1, 5], "default": -1 },
        "travel_backpack:color": { "type": "int", "range": [0, 16], "default": 0 }
      }
    },

    "component_groups": {
      "travel_backpack:despawn": { "minecraft:instant_despawn": {} },

      "travel_backpack:on_ground": {
        "minecraft:collision_box": { "width": 0.7, "height": 0.8 },
        "minecraft:environment_sensor": {
          "triggers": [
            {
              "filters": [
                {
                  "all_of": [
                    { "test": "in_block", "subject": "self", "operator": "!=", "value": "travel_backpack:leather_backpack" },
                    { "test": "in_block", "subject": "self", "operator": "!=", "value": "travel_backpack:copper_backpack" },
                    { "test": "in_block", "subject": "self", "operator": "!=", "value": "travel_backpack:iron_backpack" },
                    { "test": "in_block", "subject": "self", "operator": "!=", "value": "travel_backpack:gold_backpack" },
                    { "test": "in_block", "subject": "self", "operator": "!=", "value": "travel_backpack:diamond_backpack" },
                    { "test": "in_block", "subject": "self", "operator": "!=", "value": "travel_backpack:netherite_backpack" }
                  ]
                }
              ],
              "event": "travel_backpack:return"
            }
          ]
        }
      },

      "travel_backpack:timer": {
        "minecraft:tick_world": {},
        "minecraft:timer": { "time": 60.0, "time_down_event": { "event": "travel_backpack:archive" } }
      },

      "travel_backpack:inventory0": { "minecraft:inventory": { "container_type": "container", "inventory_size": 49  } }, /* 27  - Leather */
      "travel_backpack:inventory1": { "minecraft:inventory": { "container_type": "container", "inventory_size": 57  } }, /* 36  - Copper */
      "travel_backpack:inventory2": { "minecraft:inventory": { "container_type": "container", "inventory_size": 75  } }, /* 54  - Iron */
      "travel_backpack:inventory3": { "minecraft:inventory": { "container_type": "container", "inventory_size": 102 } }, /* 81  - Gold */
      "travel_backpack:inventory4": { "minecraft:inventory": { "container_type": "container", "inventory_size": 121 } }, /* 100 - Diamond */
      "travel_backpack:inventory5": { "minecraft:inventory": { "container_type": "container", "inventory_size": 141 } }  /* 120 - Netherite */
    },

    "components": {
      "minecraft:type_family": { "family": [ "backpack" ] },
      "minecraft:health": { "value": 1, "min": 1 },
      "minecraft:damage_sensor": { "triggers": [ { "cause": "all", "deals_damage": "no" } ] },
      "minecraft:collision_box": { "width": 0.1, "height": 0.1 },
      "minecraft:nameable": { "allow_name_tag_renaming": false },
      "minecraft:fire_immune": {},
      "minecraft:persistent": {},
      "minecraft:physics": { "has_collision": false, "has_gravity": false }
    },

    "events": {
      "travel_backpack:despawn": { "add": { "component_groups": [ "travel_backpack:despawn" ] } },
      "travel_backpack:return": { "queue_command": { "command": "scriptevent travel_backpack:return" } },
      "travel_backpack:archive": { "queue_command": { "command": "scriptevent travel_backpack:archive" } },

      "travel_backpack:add_on_ground": {
        "add": { "component_groups": [ "travel_backpack:on_ground" ] },
        "remove": { "component_groups": [ "travel_backpack:timer" ] },
        "set_property": { "travel_backpack:on_ground": true }
      },
      "travel_backpack:remove_on_ground": {
        "add": { "component_groups": [ "travel_backpack:timer" ] },
        "remove": { "component_groups": [ "travel_backpack:on_ground" ] },
        "set_property": { "travel_backpack:on_ground": false }
      },

      "travel_backpack:add_timer": { "add": { "component_groups": [ "travel_backpack:timer" ] } },
      "travel_backpack:remove_timer": { "remove": { "component_groups": [ "travel_backpack:timer" ] } },

      "travel_backpack:inventory0": {
        "add": { "component_groups": [ "travel_backpack:inventory0" ] },
        "set_property": { "travel_backpack:level": 0 },
        "queue_command": { "command": "scriptevent travel_backpack:update_level" }
      },
      "travel_backpack:inventory1": {
        "remove": { "component_groups": [ "travel_backpack:inventory0" ] },
        "add": { "component_groups": [ "travel_backpack:inventory1" ] },
        "set_property": { "travel_backpack:level": 1 },
        "queue_command": { "command": "scriptevent travel_backpack:update_level" }
      },
      "travel_backpack:inventory2": {
        "remove": { "component_groups": [
          "travel_backpack:inventory0",
          "travel_backpack:inventory1"
        ] },
        "add": { "component_groups": [ "travel_backpack:inventory2" ] },
        "set_property": { "travel_backpack:level": 2 },
        "queue_command": { "command": "scriptevent travel_backpack:update_level" }
      },
      "travel_backpack:inventory3": {
        "remove": { "component_groups": [
          "travel_backpack:inventory0",
          "travel_backpack:inventory1",
          "travel_backpack:inventory2"
        ] },
        "add": { "component_groups": [ "travel_backpack:inventory3" ] },
        "set_property": { "travel_backpack:level": 3 },
        "queue_command": { "command": "scriptevent travel_backpack:update_level" }
      },
      "travel_backpack:inventory4": {
        "remove": { "component_groups": [
          "travel_backpack:inventory0",
          "travel_backpack:inventory1",
          "travel_backpack:inventory2",
          "travel_backpack:inventory3"
        ] },
        "add": { "component_groups": [ "travel_backpack:inventory4" ] },
        "set_property": { "travel_backpack:level": 4 },
        "queue_command": { "command": "scriptevent travel_backpack:update_level" }
      },
      "travel_backpack:inventory5": {
        "remove": { "component_groups": [
          "travel_backpack:inventory0",
          "travel_backpack:inventory1",
          "travel_backpack:inventory2",
          "travel_backpack:inventory3",
          "travel_backpack:inventory4"
        ] },
        "add": { "component_groups": [ "travel_backpack:inventory5" ] },
        "set_property": { "travel_backpack:level": 5 },
        "queue_command": { "command": "scriptevent travel_backpack:update_level" }
      },

      "travel_backpack:no_color":          { "set_property": { "travel_backpack:color": 0 } },
      "travel_backpack:white_color":       { "set_property": { "travel_backpack:color": 1 } },
      "travel_backpack:light_gray_color":  { "set_property": { "travel_backpack:color": 2 } },
      "travel_backpack:gray_color":        { "set_property": { "travel_backpack:color": 3 } },
      "travel_backpack:black_color":       { "set_property": { "travel_backpack:color": 4 } },
      "travel_backpack:brown_color":       { "set_property": { "travel_backpack:color": 5 } },
      "travel_backpack:red_color":         { "set_property": { "travel_backpack:color": 6 } },
      "travel_backpack:orange_color":      { "set_property": { "travel_backpack:color": 7 } },
      "travel_backpack:yellow_color":      { "set_property": { "travel_backpack:color": 8 } },
      "travel_backpack:light_green_color": { "set_property": { "travel_backpack:color": 9 } },
      "travel_backpack:green_color":       { "set_property": { "travel_backpack:color": 10 } },
      "travel_backpack:cyan_color":        { "set_property": { "travel_backpack:color": 11 } },
      "travel_backpack:light_blue_color":  { "set_property": { "travel_backpack:color": 12 } },
      "travel_backpack:blue_color":        { "set_property": { "travel_backpack:color": 13 } },
      "travel_backpack:purple_color":      { "set_property": { "travel_backpack:color": 14 } },
      "travel_backpack:magenta_color":     { "set_property": { "travel_backpack:color": 15 } },
      "travel_backpack:pink_color":        { "set_property": { "travel_backpack:color": 16 } }
    }
  }
}
