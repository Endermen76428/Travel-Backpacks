{
  "format_version": "1.26.20",
  "minecraft:block": {
    "description": {
      "identifier": "travel_backpack:pink_leather_backpack",
      "menu_category": { "category": "none", "is_hidden_in_commands": true },
      "traits": {
        "minecraft:placement_direction": { "enabled_states": [ "minecraft:cardinal_direction" ] }
      }
    },
    "components": {
      "minecraft:tags": [ "travel_backpack:backpack", "bedrock_awakening:script_no_break" ],
      "minecraft:loot": "loot_tables/empty.json",
      "minecraft:geometry": "geometry.travel_backpack.backpack",
      "minecraft:material_instances": {
        "*": { "render_method": "alpha_test", "texture": "travel_backpack:backpack_base_pink" },
        "tier": { "render_method": "alpha_test", "texture": "travel_backpack:leather_tier" }
      },
      "minecraft:collision_box": { "origin": [-5, 0, -3], "size": [10, 12, 6] },
      "minecraft:selection_box": { "origin": [-5, 0, -3], "size": [10, 12, 6] },
      "minecraft:connection_rule": { "accepts_connections_from": "none" },
      "minecraft:light_dampening": 0,
      "minecraft:destructible_by_mining": { "seconds_to_destroy": 0.5 },
      "minecraft:destructible_by_explosion": false
    },
    "permutations": [
      {
        "condition": "q.block_state('minecraft:cardinal_direction') == 'north'",
        "components": { "minecraft:transformation": { "rotation": [0, 180, 0] } }
      },
      {
        "condition": "q.block_state('minecraft:cardinal_direction') == 'west'",
        "components": { "minecraft:transformation": { "rotation": [0, -90, 0] } }
      },
      {
        "condition": "q.block_state('minecraft:cardinal_direction') == 'east'",
        "components": { "minecraft:transformation": { "rotation": [0, 90, 0] } }
      }
    ]
  }
}