{
  "namespace": "travel_backpack-common",

  "backpack_background": {
    "type": "image",
    "texture": "textures/travel_backpack/ui/backpack_background",
    "size": [ "100%", "100%" ]
  },

  "organize_panel": {
    "type": "stack_panel",
    "offset": [ -10, -5.5 ],
    "anchor_from": "top_right",
    "anchor_to": "top_right",
    "orientation": "horizontal",
    "collection_name": "container_items",
    "controls": [
      {
        "organize_alphabetical_button@common.container_item": {
          "size": [ 16, 16 ],
          "$background_images": "common.empty_panel",
          "$button_ref": "travel_backpack-upgrade_general.functional_button",
          "$item_collection_name": "container_items",
          "collection_index": "($inventory_size +1)"
        }
      },
      { "padding@common.empty_panel": { "size": [ 2, 0] } },
      {
        "organize_numeric_button@common.container_item": {
          "size": [ 16, 16 ],
          "$background_images": "common.empty_panel",
          "$button_ref": "travel_backpack-upgrade_general.functional_button",
          "$item_collection_name": "container_items",
          "collection_index": "($inventory_size +2)"
        }
      },
      {
        "organize_alphabetical_image_panel": {
          "type": "panel",
          "size": [ 16, 16 ],
          "controls": [
            {
              "organize_alphabetical_image": {
                "type": "image",
                "texture": "textures/travel_backpack/ui/config/organize/organize_alphabetical",
                "size": [ 16, 16 ],
                "offset": [ -34, 0 ],
                "layer": 10
              }
            },
            {
              "organize_alphabetical_image": {
                "type": "image",
                "texture": "textures/travel_backpack/ui/config/organize/organize_numeric",
                "size": [ 16, 16 ],
                "offset": [ -16, 0 ],
                "layer": 10
              }
            }
          ]
        }
      }
    ]
  },

  "hover_text_data_control": {
    "collection_index": "$index",
    "type": "panel",
    "size": [ 0, 0 ],
    "bindings": [
      {
        "binding_type": "collection",
        "binding_collection_name": "container_items",
        "binding_name": "#hover_text"
      },
      {
        "binding_type": "collection",
        "binding_collection_name": "container_items",
        "binding_name": "#item_id_aux"
      },
      {
        "binding_type": "view",
        "source_property_name": "(not (#item_id_aux = -1))", /* Testa-se-tem-um-item-no-slot,-será-utilizado-para-verificar-se-o-player-está-clicando,-pois-por-algum-motivo-o-hover-text-fica-vazio-se-clicar-em-outro-slot,-isso-que-segura-e-cria-compatibilidade-entre-plataformas */
        "target_property_name": "#has_item"
      },
      {
        "binding_type": "view",
        "source_property_name": "(((#hover_text = #preserved_text) or (#hover_text = '')))", /* Atualiza-a-visibilidade-do-painel-se-o-texto-preservado-for-igual-ao-texto-atual-ou-se-o-texto-atual-está-vazio */
        "target_property_name": "#visible"
      },
      {
        "binding_type": "collection",
        "binding_collection_name": "container_items",
        "binding_condition": "visibility_changed", /* Só-atualiza-o-preserved-text-se-a-visibilidade-desse-painel-for-alterada */
        "binding_name": "#hover_text",
        "binding_name_override": "#preserved_text"
      }
    ]
  }
}